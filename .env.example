# App
NEXT_PUBLIC_SITE_URL=https://mediterraneanbear.marctonimas.com
NEXT_PUBLIC_SITE_NAME=Mediterranean Bear

# Database
DATABASE_URL=postgres://...

# Auth
AUTH_SECRET=...
# Auth.js trust host (set to true when deployed behind a proxy / on Vercel)
AUTH_TRUST_HOST=true
# AUTH_GOOGLE_ID=... (future)
# AUTH_GOOGLE_SECRET=... (future)

# Stripe
STRIPE_SECRET_KEY=sk_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Printful
PRINTFUL_API_KEY=...
PRINTFUL_STORE_ID=...
PRINTFUL_WEBHOOK_SECRET=...

# Resend
RESEND_API_KEY=re_...
EMAIL_FROM=Mediterranean Bear <hello@mediterraneanbear.com>
EMAIL_FROM_DEV=Mediterranean Bear <dev@mediterraneanbear.com>
# Optional: dedicated inbox for admin failure alerts (defaults to EMAIL_FROM)
ADMIN_EMAIL=admin@mediterraneanbear.com

# Vercel Blob
BLOB_READ_WRITE_TOKEN=...

# Shipping
DEFAULT_SHIPPING_FLAT_RATE_CENTS=595
STRIPE_TAX_ENABLED=true
